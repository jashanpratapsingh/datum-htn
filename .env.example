# VENDX environment — names only. Copy what you need; never commit real values.
# Relay secrets live in ~/.vendx/relay.env (sourced by scripts/relay.sh);
# web values live in web/.env.local and in the Vercel project settings.

# ---------------- relay-proxy ----------------
RELAY_PORT=3402
VENDX_SETTLEMENT=verify            # verify | trust (trust = demo, signs without checking the chain)
VENDX_VENDOR_WALLET=               # wallet owner that gets paid; relay.sh derives it from ~/.vendx/vendor-devnet.json
VENDX_SOLANA_RPC=                  # optional; default clusterApiUrl('devnet')
VENDX_BADGE_PORT=/dev/cu.usbmodem101
VENDX_PUBLIC_URL=https://relay.vendx.biz   # how the directory advertises this relay
VENDX_RELAY_LABEL=                 # directory label, default hostname
VENDX_HEARTBEAT_SEC=30
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=               # sb_secret_… (SUPABASE_SERVICE_ROLE_KEY also accepted). Relay only. NEVER in web/.
VENDX_WEB_SECRET=                  # shared with the website so its purchases are attributed to accounts

# ---------------- agent-buyer / MCP ----------------
RELAY_URL=https://relay.vendx.biz
VENDX_API_KEY=                     # vendx_sk_… minted on the website (Account → Agents); optional
VENDX_BUYER_KEYPAIR=               # default ~/.config/solana/id.json, else ~/.vendx/buyer-devnet.json is created
VENDX_FAKE_PAYMENT=                # 1 = fabricate the tx signature (only works against a trust-mode relay)

# ---------------- web (Next.js) ----------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # sb_publishable_…
NEXT_PUBLIC_RELAY_URL=https://relay.vendx.biz
NEXT_PUBLIC_RELAYS=                # optional: label=url,label=url
VENDX_WEB_BUYER_KEYPAIR=           # JSON array of 64 bytes; the shared devnet wallet the site buys with
VENDX_WEB_SECRET=                  # same value as the relay's
VENDX_WEB_MAX_MICRO_USDC=100000    # per-purchase ceiling for the shared wallet ($0.10)
VENDX_SOLANA_RPC=                  # optional
