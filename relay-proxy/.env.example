# relay-proxy reads process.env; for a manual run: node --env-file=.env dist/index.js
# scripts/relay.sh sets these itself.

RELAY_PORT=3402
VENDX_SETTLEMENT=verify            # verify = check the USDC transfer on-chain; trust = offline demo
VENDX_VENDOR_WALLET=               # wallet OWNER that sells (relay.sh derives it from ~/.vendx/vendor-devnet.json)
VENDX_SOLANA_RPC=https://api.devnet.solana.com
VENDX_BADGE_PORT=/dev/cu.usbmodem101
