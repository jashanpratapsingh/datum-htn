# One-command dev stack (scripts/dev.sh). Copy to ~/.vendx/dev.env and fill in.
# Real values never go in the repo.

# Supabase — hosted project Datum-htn (ref dhjhsupqdmcdyqghxace). No Docker here,
# so there is no local Supabase; the service key is server-side only.
#   supabase projects api-keys --project-ref dhjhsupqdmcdyqghxace
SUPABASE_URL=https://dhjhsupqdmcdyqghxace.supabase.co
SUPABASE_SERVICE_KEY=

# Web login sessions (HMAC key for the vendx_session cookie): openssl rand -hex 32
SESSION_SECRET=

# Browser-side Solana RPC for balances and Phantom payments (devnet).
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Which relay the local site talks to.
NEXT_PUBLIC_RELAY_URL=http://localhost:3402

# Extra SIWS domains to accept besides the request Host (comma-separated), e.g. Vercel previews.
SIWS_ALLOWED_DOMAINS=
