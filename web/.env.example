# Copy to web/.env.local for `next dev`, or let scripts/dev.sh export these from ~/.vendx/dev.env.

# Relay registry: "label=url,label=url" (or a single NEXT_PUBLIC_RELAY_URL). Default http://localhost:3402.
NEXT_PUBLIC_RELAY_URL=http://localhost:3402
# NEXT_PUBLIC_RELAYS=Laptop=http://localhost:3402,Teammate=https://relay.example.com

# Devnet RPC used in the browser for balances and Phantom payments.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server only. HMAC key for the signed session cookie (openssl rand -hex 32).
# Required on Vercel; locally a random per-process secret is used with a warning.
SESSION_SECRET=

# Server only. Supabase service key for the vendx_accounts table. Optional: login
# still works without it (the response carries warning: accounts_unavailable).
SUPABASE_URL=https://dhjhsupqdmcdyqghxace.supabase.co
SUPABASE_SERVICE_KEY=

# Server only, optional. Extra hosts accepted in the SIWS domain line.
SIWS_ALLOWED_DOMAINS=

# ---- Marketplace, dashboard and the remote MCP server (web/app/api/mcp) ----

# Public Supabase settings for the browser client (email login, RLS reads).
NEXT_PUBLIC_SUPABASE_URL=https://dhjhsupqdmcdyqghxace.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Shared with the relay (~/.vendx/relay.env) so purchases made by the
# site or the MCP server are attributed to the account and agent that bought them.
VENDX_WEB_SECRET=

# Server only. The site's shared devnet buyer for /agent (JSON array of 64 bytes).
VENDX_WEB_BUYER_KEYPAIR=

# Server only. 32 random bytes, base64 (openssl rand -base64 32). Seals every agent
# wallet's secret key at rest (AES-256-GCM). Losing it strands the wallets; rotate
# by re-sealing rows, never by generating a new one over live agents.
VENDX_WALLET_KEK=

# Optional. The public origin used in OAuth metadata and install snippets; derived
# from the request when unset. Set it once the site has its own domain.
# VENDX_SITE_URL=https://vendx.biz
